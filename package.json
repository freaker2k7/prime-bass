{
	"name": "wallet",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
		"format": "prettier --write '**/*.{scss,html,cjs,js,ts,tsx,md}' --ignore-path .prettierignore",
		"format:check": "prettier '**/*.{scss,html,cjs,js,ts,tsx,md}' --ignore-path .prettierignore --check",
		"preview": "vite preview"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "10.0.1",
		"@types/node": "25.5.2",
		"@typescript-eslint/eslint-plugin": "8.58.0",
		"eslint": "10.2.0",
		"prettier": "3.8.1",
		"sass": "1.100.0",
		"typescript": "6.0.2",
		"vite": "8.0.5",
		"vite-compatible-readable-stream": "3.6.1",
		"vite-plugin-minify": "2.1.0",
		"vite-plugin-singlefile": "2.3.2"
	},
	"dependencies": {
		"tone": "15.1.22"
	}
}
